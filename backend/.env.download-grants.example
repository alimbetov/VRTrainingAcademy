# Example only. Never commit credentials or real signed URLs.
# The public catalog remains usable when these values are absent.
VR_AUTH_ISSUER_URI=
VR_AUTH_AUDIENCE=
VR_DELIVERY_TRANSPORT=DIRECT_RUSTFS
VR_DELIVERY_S3_ENABLED=false
# Enable only when RustFS S3-compatible HTTPS endpoint is operational.
VR_DELIVERY_BASE_URL=
VR_DELIVERY_REGION=us-east-1
VR_DELIVERY_GRANT_TTL_SECONDS=300
# AWS SDK DefaultCredentialsProvider: AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY
# must be configured in a secure runtime secret store, NEVER in VR clients.
