# R3 example. Keep all feature flags FALSE until trusted identity adapters and schema are deployed.
VR_CLASSROOM_SCHOOL_TIMEZONE=Asia/Almaty
VR_CLASSROOM_PERSISTENCE_ENABLED=false
VR_CLASSROOM_JDBC_URL=
VR_CLASSROOM_JDBC_USER=
VR_CLASSROOM_JDBC_PASSWORD=
VR_DEVICE_ACTIVATION_ENABLED=false
VR_DEVICE_JDBC_URL=
VR_DEVICE_JDBC_USER=
VR_DEVICE_JDBC_PASSWORD=
# Secure 32+ byte random key as base64, generated and stored in secret manager.
# Never share the server pepper with Quest, teacher browsers or Git.
VR_DEVICE_ACTIVATION_PEPPER_B64=
# Teacher membership and OIDC Device Authorization Grant integration
# intentionally have no insecure demo defaults.

# Activation requires VR_LICENSING_PERSISTENCE_ENABLED=true and its migrated DB.
# Public start/complete HTTP calls need edge rate limits before rollout.
# Activation does NOT issue a sender-constrained device API credential.
