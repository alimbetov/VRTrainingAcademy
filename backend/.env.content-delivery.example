# Client-side JVM reference harness only; NOT Spring Boot server settings.
# Set real origin after RustFS endpoint exists. Keep downloads disabled until then.
RUSTFS_BASE_URL=
# Required: X.509-encoded Ed25519 public signing key (Base64, no private key).
VR_CONTENT_SIGNING_PUBLIC_KEY_B64=
VR_CONTENT_LOCAL_ROOT=./.local-vr-content
VR_CONTENT_PLATFORM=windows
VR_CONTENT_RUNTIME_BUILD_ID=runtime-001
VR_CONTENT_MAX_INSTALLED=3
VR_CONTENT_DISK_RESERVE_BYTES=536870912
# Only for a localhost/mock RustFS during development, never production.
VR_CONTENT_ALLOW_HTTP_LOCAL_TESTS=false
